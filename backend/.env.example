# Copy to .env (git-ignored) and fill in. Then: pwsh scripts/setup.ps1 -ApplyEnv
# Optional: GitHub MCP, fine-grained personal access token
GITHUB_TOKEN=
# Optional: database MCP; point at the LOCAL docker database only, never a shared one
DATABASE_URL=postgres://dev:dev@localhost:5432/app
# Local docker services (docker/compose.yml)
POSTGRES_PASSWORD=dev
