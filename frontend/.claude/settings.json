{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pwsh scripts/verify.ps1)",
      "Bash(pwsh scripts/security-scan.ps1)",
      "Bash(pwsh scripts/cleanup-scan.ps1)",
      "Bash(pwsh scripts/sync-docs.ps1 -Check)",
      "Bash(pwsh scripts/setup.ps1)",
      "PowerShell(pwsh scripts/verify.ps1)",
      "PowerShell(pwsh scripts/security-scan.ps1)",
      "PowerShell(pwsh scripts/cleanup-scan.ps1)",
      "PowerShell(pwsh scripts/sync-docs.ps1 -Check)",
      "PowerShell(pwsh scripts/setup.ps1)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./project/.env*)",
      "Edit(./.env)",
      "Bash(git push --no-verify*)",
      "Bash(git commit --no-verify*)",
      "PowerShell(git push --no-verify*)",
      "PowerShell(git commit --no-verify*)",
      "Edit(./benchmarks/**)",
      "Edit(./.githooks/**)"
    ]
  }
}
